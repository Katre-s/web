{
  "name": "wenheng-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "徐工院小咸鱼 - 校园二手集市 Windows 客户端",
  "author": "小咸鱼团队",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node verify-smoke.js",
    "build:web": "npm --prefix ../web run build:desktop",
    "prepare:electron": "node scripts/prepare-electron.js",
    "pack": "npm run build:web && electron-builder --win --x64 -c.electronDist=node_modules/electron/dist",
    "pack:dir": "npm run build:web && electron-builder --win --dir -c.electronDist=node_modules/electron/dist"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wenheng.desktop",
    "productName": "Xiaoxianyu",
    "copyright": "Copyright © 2026 Xiaoxianyu",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Xiaoxianyu-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小咸鱼",
      "artifactName": "Xiaoxianyu-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Xiaoxianyu-Portable-${version}.${ext}"
    }
  }
}