# 安卓 App 构建（vite build --mode mobile）
# WebView 里页面源是 https://localhost（或 capacitor://），相对 /api 指不到服务器，
# 所以这里直接写绝对地址，不依赖运行时判断，最稳。
VITE_API_BASE=http://121.40.219.139:3000/api
VITE_API_ORIGIN=http://121.40.219.139:3000
# App 启动后优先加载线上最新版（检测 /api/health 可达后跳转），
# 网页更新无需重新打包 APK；服务器不可达时自动继续用内置包。
VITE_REMOTE_SHELL=http://121.40.219.139
VITE_MOBILE=1
