PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_trade
DB_USER=root
DB_PASSWORD=your_mysql_password
# 默认 false：启动只做 sync()，不逐表 alter（alter 会拖慢启动并可能锁表）
# 仅当新增字段/索引需要同步表结构时，临时改为 true 启动一次再改回 false
DB_SYNC_ALTER=false

JWT_SECRET=xiaoxianyu_secret_change_this_2026
JWT_EXPIRES=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

OPEN_LIBRARY_URL=https://openlibrary.org/api/books
GOOGLE_BOOKS_URL=https://www.googleapis.com/books/v1/volumes

BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

AI_API_KEY=
AI_API_URL=https://api.siliconflow.cn/v1/chat/completions
# 视觉模型（扫码识别书封面/ISBN 用）
AI_MODEL=zai-org/GLM-5.3-Flash

# ============ 「AI 对话 / 智能助手」模型 ============
# CHAT_API_* 是"聊天回复"用的模型，不填则回退 AI_API_*。
#
# 【方案A｜云端回复（默认，线上更稳）】硅基流动 DeepSeek V4.1，与 AI_API_* 同一把 Key
CHAT_API_URL=https://api.siliconflow.cn/v1/chat/completions
CHAT_API_KEY=
CHAT_API_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
#
# 【方案B｜整个聊天也走本地 Ollama】
# 把上面【方案A】三行注释掉，改成：
# CHAT_API_URL=http://127.0.0.1:11434/v1/chat/completions
# CHAT_API_KEY=
# CHAT_API_MODEL=qwen2.5:7b
#
# ============ 本地大模型「中介」============
# 分工：本地模型只负责"听懂需求 + 决定调哪个后端工具"，回复文案仍由上面的 CHAT_API_*（DeepSeek）生成。
# 不配这三行时，router 自动回退到 CHAT_API_*（由云端模型兼任决策），功能不受影响，只是少了本地这一环。
#
# 用法：
# 1) 本地启动 Ollama，确认模型带 tools 能力（curl http://127.0.0.1:11434/api/tags 看 capabilities）
# 2) 本地建 SSH 反向隧道，把本地 11434 映射到服务器本地端口：
#      ssh -R 11434:localhost:11434 -N -o ServerAliveInterval=30 root@服务器IP
# 3) 打开下面三行（本地 Ollama 是 OpenAI 兼容接口，路径必须带 /v1/chat/completions）
# AGENT_ROUTER_API_URL=http://127.0.0.1:11434/v1/chat/completions
# AGENT_ROUTER_API_KEY=
# AGENT_ROUTER_API_MODEL=my-qwen3-finetuned:latest
#
# AGENT_TOOL_MODE 决定"谁来决策后端操作"：
#   rules  = 纯规则引擎，完全不问模型（最快最稳）
#   hybrid = 规则优先，规则没命中时问本地中介（默认，推荐）
#   llm    = 本地中介优先调工具，模型不可用才回退规则（最"由本地模型操作"）
AGENT_TOOL_MODE=hybrid
# 后端执行完操作后，是否再让 CHAT_API_* 把结果说人话（off 则直接用后端模板文案，省一次请求）
# AGENT_POLISH=on
# 模型调工具的等待时间（毫秒）。本地模型首次加载较慢，可调大
# AGENT_TIMEOUT=60000
# CHAT_TIMEOUT=60000

# 首页推荐用的轻量模型：默认复用 AI_API_* 的云端（快），避免本地对话模型推理慢导致 4s 超时
# RECOMMEND_API_URL=
# RECOMMEND_API_MODEL=
# RECOMMEND_TIMEOUT=8000

# ============ 邮件验证码（163 邮箱 SMTP）============
# 注意：163 邮箱需要在「设置 → POP3/SMTP」开启 SMTP 服务，
# 密码处填写「授权码」（不是登录密码，在网易邮箱设置里生成）
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=XGxianyu@163.com
MAIL_PASS=填你的163邮箱授权码

# 首页实时天气（Open-Meteo，免 Key）。不配置就是默认的徐州云龙区。
# 换城市只需改这三个值；城市名会显示在首页天气卡片上。
WEATHER_DEFAULT_LAT=34.2538
WEATHER_DEFAULT_LON=117.2264
WEATHER_DEFAULT_CITY=徐州云龙区