PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_trade
DB_USER=root
DB_PASSWORD=your_mysql_password
# 默认 false：启动只做 sync()，不逐表 alter（alter 会拖慢启动并可能锁表）
# 仅当新增字段/索引需要同步表结构时，临时改为 true 启动一次再改回 false
DB_SYNC_ALTER=false

JWT_SECRET=wenheng_secret_change_this_2026
JWT_EXPIRES=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

OPEN_LIBRARY_URL=https://openlibrary.org/api/books
GOOGLE_BOOKS_URL=https://www.googleapis.com/books/v1/volumes

BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

AI_API_KEY=
AI_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 本地大模型(仅用于「AI 对话」助手)。配置了以下任一 CHAT_API_* 即生效，
# 否则对话会回退使用上面的 AI_API_*。视觉模型(扫码识别)仍走 AI_API_*。
# 常见本地服务地址：
#   Ollama       http://127.0.0.1:11434/v1/chat/completions
#   LM Studio    http://127.0.0.1:1234/v1/chat/completions
#   vLLM         http://127.0.0.1:8000/v1/chat/completions
# 若本地服务免密，CHAT_API_KEY 留空即可(鉴权头会自动省略)。
CHAT_API_URL=http://127.0.0.1:11434/v1/chat/completions
CHAT_API_KEY=
CHAT_API_MODEL=my-qwen3-finetuned:latest
# CHAT_TIMEOUT=60000

# 首页实时天气（Open-Meteo，免 Key）。不配置就是默认的徐州云龙区。
# 换城市只需改这三个值；城市名会显示在首页天气卡片上。
WEATHER_DEFAULT_LAT=34.2538
WEATHER_DEFAULT_LON=117.2264
WEATHER_DEFAULT_CITY=徐州云龙区

MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=